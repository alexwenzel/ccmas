{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccmas.invalid/contracts/plan-v1.schema.json",
  "title": "CCMAS Planungsergebnis des Supervisors (v1)",
  "description": "Ein Planungsergebnis (DecisionBatch) bündelt mehrere Entscheidungen des Supervisors für denselben Zustand. Formal gültig ist nicht gleich ausführbar: Go prüft den Batch gegen den ProjectSnapshot (internal/supervisor) und führt nichts aus, solange auch nur eine Entscheidung abgelehnt wird.",
  "$defs": {
    "decision_batch": {
      "type": "object",
      "required": [
        "schema_version", "batch_id", "project_id", "state_revision", "goal", "rationale", "decisions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1, "x-error-class": "version" },
        "batch_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "project_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "state_revision": { "$ref": "common-v1.schema.json#/$defs/uint" },
        "goal": {
          "description": "Zielbezug: das beauftragte Ziel, für das geplant wird.",
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["ticket", "feature", "milestone"], "x-error-class": "value" },
            "id": { "$ref": "common-v1.schema.json#/$defs/id" }
          }
        },
        "rationale": { "$ref": "common-v1.schema.json#/$defs/rationale_text" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "decision-v1.schema.json#/$defs/decision" }
        }
      }
    }
  }
}
