{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccmas.invalid/contracts/runner-v1.schema.json",
  "title": "CCMAS Runner-Protokoll (v1)",
  "description": "JSON-Lines-Protokoll zwischen Go-Dienst und Python-Runner: Umschlag, Nachrichten-Payloads, Frage/Antwort und Review-Bericht. Eine Nachricht ist eine JSON-Zeile.",
  "x-max-message-bytes": 1048576,
  "$defs": {
    "envelope_common": {
      "type": "object",
      "required": [
        "protocol_version", "project_id", "execution_id", "attempt",
        "correlation_id", "type", "timestamp", "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": "1", "x-error-class": "version" },
        "project_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "execution_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "correlation_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "type": {
          "enum": [
            "start", "answer", "interrupt", "stop",
            "session_started", "activity", "tool_event", "question", "result", "error"
          ],
          "x-error-class": "message_type"
        },
        "timestamp": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "payload": { "type": "object" }
      }
    },
    "envelope_to_runner": {
      "description": "Go nach Python: start, answer, interrupt, stop. Verengt nur den Typ des gemeinsamen Umschlags; unbekannte Felder weist envelope_common ab (additionalProperties statt unevaluatedProperties, weil dessen Verhalten bei Fehlern in Teilschemas je Bibliothek abweicht).",
      "$ref": "#/$defs/envelope_common",
      "properties": {
        "type": {
          "enum": ["start", "answer", "interrupt", "stop"],
          "x-error-class": "message_type"
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "start" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/run_spec" } } } },
        { "if": { "properties": { "type": { "const": "answer" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/answer" } } } },
        { "if": { "properties": { "type": { "const": "interrupt" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/interrupt" } } } },
        { "if": { "properties": { "type": { "const": "stop" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/stop" } } } }
      ]
    },
    "envelope_from_runner": {
      "description": "Python nach Go: session_started, activity, tool_event, question, result, error.",
      "$ref": "#/$defs/envelope_common",
      "properties": {
        "type": {
          "enum": ["session_started", "activity", "tool_event", "question", "result", "error"],
          "x-error-class": "message_type"
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "session_started" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/session_started" } } } },
        { "if": { "properties": { "type": { "const": "activity" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/activity" } } } },
        { "if": { "properties": { "type": { "const": "tool_event" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/tool_event" } } } },
        { "if": { "properties": { "type": { "const": "question" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/question" } } } },
        { "if": { "properties": { "type": { "const": "result" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/result" } } } },
        { "if": { "properties": { "type": { "const": "error" } }, "required": ["type"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/error" } } } }
      ]
    },

    "run_spec": {
      "description": "Payload von start (RunSpec): vollständiger Ausführungsauftrag. Der Runner verwendet cwd und claude_binary unverändert.",
      "type": "object",
      "required": [
        "work_order_id", "role", "runtime", "model", "effort", "skill_ids",
        "policy_profile", "cwd", "claude_binary", "prompt", "max_runtime_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "work_order_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "profile_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "profile_version": { "$ref": "common-v1.schema.json#/$defs/positive_int" },
        "role": { "$ref": "common-v1.schema.json#/$defs/role" },
        "runtime": { "$ref": "common-v1.schema.json#/$defs/runtime" },
        "model": { "$ref": "common-v1.schema.json#/$defs/model" },
        "effort": { "$ref": "common-v1.schema.json#/$defs/effort" },
        "skill_ids": { "$ref": "common-v1.schema.json#/$defs/skill_ids" },
        "policy_profile": { "$ref": "common-v1.schema.json#/$defs/id" },
        "cwd": { "$ref": "common-v1.schema.json#/$defs/abs_path" },
        "claude_binary": { "$ref": "common-v1.schema.json#/$defs/abs_path" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "skill_snapshot": {
          "description": "Unveränderlicher Skill-Snapshot der Ausführung (Plugin-Layout, siehe docs/architecture/skill-migration.md). Optional, ab CC-35. Der Runner prüft ihn vor dem Start gegen snapshot.json und lädt genau dessen Skills; skill_ids ohne skill_snapshot ist ein Fehler des Runners (skill_snapshot_missing), kein Vertragsverstoß.",
          "type": "object",
          "required": ["snapshot_id", "path"],
          "additionalProperties": false,
          "properties": {
            "snapshot_id": { "$ref": "skill-snapshot-v1.schema.json#/$defs/snapshot_id" },
            "path": { "$ref": "common-v1.schema.json#/$defs/abs_path" }
          }
        },
        "system_prompt": {
          "description": "Systemprompt der Sitzung (Rollenvorgabe, siehe prompts/). Optional, ab CC-14. Ohne Angabe startet das SDK die CLI mit --system-prompt \"\" (kein Standardprompt von Claude Code); mit Angabe ersetzt dieser Text den Systemprompt vollständig. Der Prompt geht als Kommandozeilenargument an die CLI, daher die Obergrenze.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "output_schema": {
          "description": "JSON-Schema (Draft-07, wie es das SDK prüft) für die strukturierte Ausgabe der Sitzung (output_format). Optional, ab CC-14. Mit Angabe endet ein erfolgreicher Versuch nur mit result.structured_output, sonst mit einem eigenen Fehlercode (structured_output_failed, structured_output_missing, structured_output_invalid). Der Vertrag lässt nur ein Objekt zu, verbietet $schema außer Draft-07 und die Schlüsselwörter von Draft 2020-12 auf oberster Ebene und begrenzt die Größe (x-max-bytes: kanonische Form, sortierte Schlüssel, kompakt, UTF-8; geprüft in Go und Python nach dem Schema); tiefer liegende Schlüsselwörter prüfen Go (CheckOutputSchema) und der Runner (Draft-07-Metaschema).",
          "type": "object",
          "maxProperties": 32,
          "x-max-bytes": 32768,
          "properties": { "$schema": { "const": "http://json-schema.org/draft-07/schema#" } },
          "not": {
            "anyOf": [
              { "required": ["$defs"] }, { "required": ["prefixItems"] }, { "required": ["unevaluatedProperties"] },
              { "required": ["unevaluatedItems"] }, { "required": ["dependentSchemas"] }, { "required": ["dependentRequired"] },
              { "required": ["$anchor"] }, { "required": ["$dynamicRef"] }, { "required": ["$dynamicAnchor"] },
              { "required": ["$recursiveRef"] }, { "required": ["minContains"] }, { "required": ["maxContains"] }
            ]
          }
        },
        "resume_session_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "max_runtime_seconds": {
          "type": "integer", "minimum": 1, "maximum": 86400, "x-error-class": "limit"
        }
      }
    },
    "answer": {
      "description": "Antwort auf eine Frage (Payload von answer). delivery_confirmed_at wird erst nach bestätigter Zustellung gesetzt und nie mitgesendet.",
      "type": "object",
      "required": ["answer_id", "question_id", "text", "created_at"],
      "additionalProperties": false,
      "properties": {
        "answer_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "question_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "text": { "$ref": "common-v1.schema.json#/$defs/body_text" },
        "created_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "delivery_confirmed_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
      }
    },
    "interrupt": {
      "description": "Kontrollierter Interrupt: beendet die laufende Runde.",
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["user_request", "timeout", "shutdown", "superseded"], "x-error-class": "value" }
      }
    },
    "stop": {
      "description": "Kontrollierter Stopp: beendet die Sitzung.",
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["user_request", "timeout", "shutdown", "superseded"], "x-error-class": "value" }
      }
    },

    "session_started": {
      "description": "Sitzung gestartet; model und effort sind die wirksamen Werte (eine dokumentierte Reduktion der Effort-Stufe wird hier sichtbar).",
      "type": "object",
      "required": ["session_id", "model", "effort", "claude_version"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "model": { "$ref": "common-v1.schema.json#/$defs/model" },
        "effort": { "$ref": "common-v1.schema.json#/$defs/effort" },
        "claude_version": { "$ref": "common-v1.schema.json#/$defs/label" },
        "permission_mode": {
          "description": "Wirksamer Berechtigungsmodus der Sitzung laut Init-Meldung der CLI (zum Beispiel dontAsk). Optional, ab CC-17.",
          "$ref": "common-v1.schema.json#/$defs/label"
        },
        "claude_binary": {
          "description": "Tatsächlich gestartetes Claude-Code-Binary (absoluter Pfad). Optional, ab CC-17.",
          "$ref": "common-v1.schema.json#/$defs/abs_path"
        },
        "auth_source": {
          "description": "Art der aktiven Anmeldung, nie Konto-, E-Mail- oder Organisationsdaten. claude_ai: Abonnement-Anmeldung; api_key und other werden vom Runner nie als Betriebsweg gemeldet. Optional, ab CC-17.",
          "enum": ["claude_ai", "api_key", "other"],
          "x-error-class": "value"
        },
        "skill_snapshot_id": {
          "description": "Snapshot, aus dem die Skills dieser Sitzung geladen wurden; nur bei einem Skill-Snapshot im Auftrag. Optional, ab CC-35.",
          "$ref": "skill-snapshot-v1.schema.json#/$defs/snapshot_id"
        },
        "skills": {
          "description": "Skill-IDs ohne Plugin-Präfix, die die CLI laut Init-Meldung wirksam geladen hat (gleich der Menge im Snapshot; weicht sie ab, bricht der Runner mit skills_not_loaded ab). Nur bei einem Skill-Snapshot im Auftrag; eine leere Liste heißt: keine Skills geladen. Optional, ab CC-35.",
          "$ref": "common-v1.schema.json#/$defs/skill_ids"
        },
        "sdk_version": {
          "description": "Version des Claude Agent SDK, mit dem der Runner läuft (gepinnt, der Runner bricht bei Abweichung ab). Optional, ab CC-14.",
          "$ref": "common-v1.schema.json#/$defs/label"
        }
      }
    },
    "activity": {
      "description": "Beobachtbare Aktivität. Keine Fortschrittsprozente.",
      "type": "object",
      "required": ["kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["assistant_text", "thinking", "waiting", "idle"], "x-error-class": "value" },
        "summary": { "$ref": "common-v1.schema.json#/$defs/summary_text" }
      }
    },
    "tool_event": {
      "type": "object",
      "required": ["tool_use_id", "tool", "phase"],
      "additionalProperties": false,
      "properties": {
        "tool_use_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "tool": { "$ref": "common-v1.schema.json#/$defs/label" },
        "phase": { "enum": ["started", "finished", "failed"], "x-error-class": "value" },
        "summary": { "$ref": "common-v1.schema.json#/$defs/summary_text" }
      }
    },
    "question": {
      "description": "Rückfrage des Workers (Payload von question). Zustand, Auftrag und Ausführung ergänzt Go aus dem Umschlag.",
      "type": "object",
      "required": ["question_id", "question", "context"],
      "additionalProperties": false,
      "properties": {
        "question_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "question": { "$ref": "common-v1.schema.json#/$defs/body_text" },
        "context": { "$ref": "common-v1.schema.json#/$defs/context_text" },
        "recommendation": { "$ref": "common-v1.schema.json#/$defs/note_text" }
      }
    },
    "result": {
      "description": "Terminales Ergebnis (höchstens eines je Ausführung und Versuch). Reviewer liefern zusätzlich review_report.",
      "type": "object",
      "required": ["outcome", "summary"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "enum": ["succeeded", "controlled_failure", "cancelled"], "x-error-class": "value" },
        "summary": { "$ref": "common-v1.schema.json#/$defs/body_text" },
        "review_report": { "$ref": "#/$defs/review_report" },
        "structured_output": {
          "description": "Strukturierte Ausgabe der Sitzung (ResultMessage.structured_output), nur wenn der Auftrag output_schema trug und die Ausgabe dessen Schema erfüllt. Optional, ab CC-14. Das Schema der Ausgabe ist der Auftrag, nicht dieser Vertrag; Go prüft den Inhalt fachlich (zum Beispiel gegen plan-v1 und den ProjectSnapshot). Größe begrenzt (x-max-bytes, siehe output_schema).",
          "type": "object",
          "maxProperties": 64,
          "x-max-bytes": 262144
        }
      }
    },
    "error": {
      "description": "Fehlermeldung. terminal=true ist ein terminales Ergebnis des Versuchs, terminal=false eine Warnung ohne Zustandswirkung.",
      "type": "object",
      "required": ["code", "message", "kind", "terminal"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "not": { "pattern": "\\n" },
          "x-error-class": "value"
        },
        "message": { "$ref": "common-v1.schema.json#/$defs/note_text" },
        "kind": { "enum": ["runtime", "subscription_limit", "protocol", "internal"], "x-error-class": "value" },
        "terminal": { "type": "boolean" }
      }
    },

    "review_report": {
      "description": "Unabhängiger Review-Bericht, gebunden an Commit und Konzeptversion. FREIGEGEBEN verlangt leere, BEFUNDE mindestens einen Befund.",
      "type": "object",
      "required": [
        "report_id", "work_order_id", "reviewer_execution_id", "commit",
        "concept_version", "verdict", "findings", "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "report_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "work_order_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "reviewer_execution_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "commit": { "$ref": "common-v1.schema.json#/$defs/git_commit" },
        "concept_version": { "$ref": "common-v1.schema.json#/$defs/label" },
        "verdict": { "enum": ["FREIGEGEBEN", "BEFUNDE"], "x-error-class": "value" },
        "findings": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["finding_id", "severity", "summary"],
            "additionalProperties": false,
            "properties": {
              "finding_id": { "$ref": "common-v1.schema.json#/$defs/id" },
              "severity": { "enum": ["blocker", "major", "minor"], "x-error-class": "value" },
              "summary": { "$ref": "common-v1.schema.json#/$defs/rationale_text" },
              "location": { "$ref": "common-v1.schema.json#/$defs/label" }
            }
          }
        },
        "created_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "verdict": { "const": "FREIGEGEBEN" } }, "required": ["verdict"] },
          "then": { "properties": { "findings": { "const": [] } } } },
        { "if": { "properties": { "verdict": { "const": "BEFUNDE" } }, "required": ["verdict"] },
          "then": { "properties": { "findings": { "minItems": 1 } } } }
      ]
    }
  }
}
