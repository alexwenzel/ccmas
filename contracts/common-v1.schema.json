{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccmas.invalid/contracts/common-v1.schema.json",
  "title": "CCMAS gemeinsame Definitionen (v1)",
  "description": "Von allen Verträgen gemeinsam genutzte Bausteine. Die Kennung unter $id ist nur ein Name und wird nie abgerufen. Das Schlüsselwort x-error-class ordnet einen Verstoß einer Fehlerklasse zu; Go und Python lesen es identisch aus.",
  "x-error-classes": [
    "syntax", "size", "version", "field", "unknown_field", "id", "path", "model", "effort",
    "action", "message_type", "timestamp", "limit", "role", "commit", "value"
  ],
  "$defs": {
    "id": {
      "description": "Stabile ID: Buchstaben, Ziffern und . _ : - ; beginnt alphanumerisch; höchstens 128 Zeichen.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": { "pattern": "\\n" },
      "x-error-class": "id"
    },
    "abs_path": {
      "description": "Kanonischer absoluter Pfad: beginnt mit /, keine leeren, . oder .. Segmente, kein abschließender / (außer der Wurzel), keine Steuerzeichen.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(/[^/]+)+$|^/$",
      "not": { "pattern": "[\\x00-\\x1f\\x7f]|(^|/)\\.\\.?(/|$)" },
      "x-error-class": "path"
    },
    "rel_path": {
      "description": "Kanonischer relativer Pfad: kein führender oder abschließender /, keine leeren, . oder .. Segmente, keine Steuerzeichen.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/]+(/[^/]+)*$",
      "not": { "pattern": "[\\x00-\\x1f\\x7f]|(^|/)\\.\\.?(/|$)" },
      "x-error-class": "path"
    },
    "model": {
      "description": "Modell-ID als nicht leere Zeichenkette ohne Leer- und Steuerzeichen. Ob das Modell bekannt ist, prüft Go gegen die konfigurierte Profilliste.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": { "pattern": "[\\x00-\\x20\\x7f]" },
      "x-error-class": "model"
    },
    "effort": {
      "description": "Effort-Stufe. Welche Stufen ein Modell unterstützt, prüft Go gegen die konfigurierte Profilliste.",
      "enum": ["low", "medium", "high", "xhigh", "max"],
      "x-error-class": "effort"
    },
    "role": {
      "enum": [
        "supervisor", "project_setup", "concept", "concept_reviewer", "implementer",
        "reviewer", "documentation", "completion", "question_handler"
      ],
      "x-error-class": "role"
    },
    "runtime": {
      "enum": ["claude"],
      "x-error-class": "value"
    },
    "integration_mode": {
      "enum": ["pr", "auto"],
      "x-error-class": "value"
    },
    "timestamp": {
      "description": "RFC 3339 mit Zeitzone (Z oder +hh:mm), Großbuchstaben T/Z, Jahr 1000-9999, gültiges Kalenderdatum einschließlich Schaltjahren, Sekunde 00-59, optional 1-9 Nachkommastellen.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^(([1-9][0-9]{3}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8])))|(([1-9][0-9](0[48]|[2468][048]|[13579][26])|([2468][048]|[13579][26])00)-02-29))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "not": { "pattern": "\\n" },
      "x-error-class": "timestamp"
    },
    "git_commit": {
      "description": "Voller Git-Commit-Hash (SHA-1, 40 Kleinbuchstaben-Hexziffern).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": { "pattern": "\\n" },
      "x-error-class": "commit"
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_int": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "summary_text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "rationale_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "note_text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "body_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "context_text": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "label": {
      "description": "Kurzer Name ohne Steuerzeichen (zum Beispiel Werkzeugname, Konzeptversion).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": { "pattern": "[\\x00-\\x1f\\x7f]" }
    },
    "skill_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
