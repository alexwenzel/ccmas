{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccmas.invalid/contracts/project-v1.schema.json",
  "title": "CCMAS Projekt, Profile und Arbeitsauftrag (v1)",
  "description": "Konfigurationsverträge. Unbekannte Schlüssel sind Fehler. Pfade sind kanonisch und absolut, Namen sind auf stabile IDs aufgelöst.",
  "$defs": {
    "project_config": {
      "type": "object",
      "required": [
        "schema_version", "project_id", "code_dir", "execution_dir", "repository",
        "base_branch", "vault", "asana_project_gid"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1, "x-error-class": "version" },
        "project_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "code_dir": { "$ref": "common-v1.schema.json#/$defs/abs_path" },
        "execution_dir": { "$ref": "common-v1.schema.json#/$defs/abs_path" },
        "repository": {
          "description": "GitHub-Repository als owner/name.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
          "not": { "pattern": "\\n" },
          "maxLength": 200,
          "x-error-class": "value"
        },
        "base_branch": { "const": "develop", "x-error-class": "value" },
        "vault": {
          "type": "object",
          "required": ["id", "path", "project_area"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "common-v1.schema.json#/$defs/id" },
            "path": { "$ref": "common-v1.schema.json#/$defs/abs_path" },
            "project_area": { "$ref": "common-v1.schema.json#/$defs/rel_path" }
          }
        },
        "asana_project_gid": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$",
          "not": { "pattern": "\\n" },
          "x-error-class": "id"
        },
        "max_workers": { "type": "integer", "minimum": 1, "maximum": 16, "default": 3, "x-error-class": "limit" },
        "default_mode": { "$ref": "common-v1.schema.json#/$defs/integration_mode", "default": "pr" },
        "channels": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["cli", "tui", "remote"], "x-error-class": "value" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_parallel_builds": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1, "x-error-class": "limit" },
            "monitor_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 5, "x-error-class": "limit" },
            "planning_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 60, "x-error-class": "limit" },
            "attempt_runtime_minutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 60, "x-error-class": "limit" }
          }
        }
      }
    },
    "agent_profile": {
      "type": "object",
      "required": ["profile_id", "version", "role", "runtime", "model", "effort", "skill_ids", "policy_profile"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "version": { "$ref": "common-v1.schema.json#/$defs/positive_int" },
        "role": { "$ref": "common-v1.schema.json#/$defs/role" },
        "runtime": { "$ref": "common-v1.schema.json#/$defs/runtime" },
        "model": { "$ref": "common-v1.schema.json#/$defs/model" },
        "effort": { "$ref": "common-v1.schema.json#/$defs/effort" },
        "skill_ids": { "$ref": "common-v1.schema.json#/$defs/skill_ids" },
        "policy_profile": { "$ref": "common-v1.schema.json#/$defs/id" }
      }
    },
    "work_order": {
      "type": "object",
      "required": [
        "work_order_id", "project_id", "target", "user_order", "goal",
        "acceptance_criteria", "allowed_scope", "mode", "plan_version", "state"
      ],
      "additionalProperties": false,
      "properties": {
        "work_order_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "project_id": { "$ref": "common-v1.schema.json#/$defs/id" },
        "target": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["ticket", "feature", "milestone"], "x-error-class": "value" },
            "ref": { "$ref": "common-v1.schema.json#/$defs/id" }
          }
        },
        "user_order": { "$ref": "common-v1.schema.json#/$defs/body_text" },
        "goal": { "$ref": "common-v1.schema.json#/$defs/body_text" },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "common-v1.schema.json#/$defs/body_text" }
        },
        "allowed_scope": {
          "description": "Erlaubter Umfang als relative Pfade im Worktree.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/rel_path" }
        },
        "mode": { "$ref": "common-v1.schema.json#/$defs/integration_mode" },
        "plan_version": { "$ref": "common-v1.schema.json#/$defs/uint" },
        "state": {
          "enum": [
            "waiting", "in_progress", "validation", "review",
            "waiting_integration", "completed", "blocked", "cancelled"
          ],
          "x-error-class": "value"
        }
      }
    }
  }
}
